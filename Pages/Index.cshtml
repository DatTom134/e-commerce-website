				console.error('CartKey is missing');
				return;
			}
			var zDataRequest = {
				'CartKey': CartKey,
				'ProductKey': ProductKey
			}
			$.ajax({
				type: 'POST',
				url: '/GioHang/TaskToDo?handler=DeleteItem',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify(zDataRequest),
			})
