	<script>
		$(document).ready(function () {
			$('.signin-form').submit(function (e) {
				// Lấy giá trị của mật khẩu và xác nhận mật khẩu từ các trường input
				var password = $('#password').val();
				var confirmPassword = $('#confirmPassword').val();

				// Kiểm tra xem mật khẩu và xác nhận mật khẩu có khớp nhau không
				if (password !== confirmPassword) {
					// Nếu không khớp, hiển thị thông báo và ngăn form submit
					alert('Mật khẩu và xác nhận mật khẩu không khớp.');
					e.preventDefault(); // Ngăn form submit nếu mật khẩu không khớp
				}
			});
		});
	</script>

	<script>
		$(document).ready(function () {
			$('#registerButton').click(function (event) {
				event.preventDefault(); // Ngăn hành động mặc định của nút

				// Lấy giá trị từ các trường input
				const username = $('#name').val();
				const email = $('#email').val();
				const password = $('#password').val();
				const confirmPassword = $('#rpassword').val();

				// Kiểm tra dữ liệu đầu vào
				if (!username || !email || !password || !confirmPassword) {
					return;
				}
				if (password !== confirmPassword) {
					return;
				}

				// Gửi AJAX
				const requestData = {
					TenDangNhap: username,
					Email: email,
					MatKhau: password,
					XacNhanMatKhau: confirmPassword
				};

				console.log('trước hàm thực hiện ajax' + requestData);
				$.ajax({
					url: '/Account/Register?handler=Register',
					method: 'POST',
					contentType: 'application/json',
					data: JSON.stringify(requestData), 

					success: function (response) {
						console.log(response);
						if (response) {
							// setTimeout(() => {
							// 	window.location.href = "/Account/Login";
							// }, 2000);
						}
					},
					error: function ( error) {
						console.error('Error:', error);  // Basic error logging
						console.log('Error responseText:', error.responseText);  // The error response
						console.log('Error status:', error.status);  // HTTP status code
						console.log('Error statusText:', error.statusText); // Error description
						console.log(error.message);
						}
				});
			});
		});
	</script>


