													<span class="cart-price">${VND.format(Price)}</span>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
						`
			}			
			CartPage.append(CartData)
			let CartFooter = `<div class="ajaxcart__footer ajaxcart__footer--fixed cart-footer" bis_skin_checked="1">
											<div class="row" bis_skin_checked="1">
												<div class="col-lg-4 col-12 offset-md-8 offset-lg-8 offset-xl-8" bis_skin_checked="1">
													<div class="ajaxcart__subtotal" bis_skin_checked="1">
														<div class="cart__subtotal" bis_skin_checked="1">
															<div class="cart__col-6" bis_skin_checked="1">Tổng tiền:</div>
															<div class="text-right cart__totle" bis_skin_checked="1"><span class="total-price">${VND.format(total)}</span></div>
														</div>
													</div>
													<div class="cart__btn-proceed-checkout-dt" bis_skin_checked="1">
														<button onclick="location.href='/ThanhToan/checkout'" type="button" class="button btn btn-default cart__btn-proceed-checkout" id="btn-proceed-checkout" title="Thanh toán">Thanh toán</button>
													</div>
												</div>
											</div>
										</div>`
			CartPage.append(CartFooter)
		}
		InitQuantityButtons()
	}	
</script>

<script>
	// Khởi tạo nút thay đổi số lượng
	function InitQuantityButtons() {
		$(document).off('click', '.ajaxcart__qty--minus, .ajaxcart__qty--plus');
		$(document).on('click', '.ajaxcart__qty--minus, .ajaxcart__qty--plus', async function () {
			const input = $(this).siblings('.ajaxcart__qty-num');
			let currentQty = parseInt(input.val()) || 0;
			let newQuantity = $(this).hasClass('ajaxcart__qty--minus') ? Math.max(currentQty - 1, 0) : currentQty + 1;

			if (newQuantity === 0) {
				await DeleteItem(this);
			} else {
				await UpdateCart(this, newQuantity);
			}
		});

		// Lắng nghe sự kiện thay đổi giá trị trong ô input
		$(document).off('blur', '.ajaxcart__qty-num');
		$(document).on('blur', '.ajaxcart__qty-num', async function () {
			const input = $(this);
			let newQuantity = parseInt(input.val()) || 0;
			if (newQuantity < 0) newQuantity = 0;
			const productKey = input.data('id');

			if (newQuantity === 0) {
				await DeleteItem(input);
			} else {
				await UpdateCart(input, newQuantity);
			}
		});
	}

	async function UpdateCart(element, newQuantity) {
		const productKey = $(element).data('id');
		const zDataRequest = { "CartKey": CartKey, "ProductKey": productKey, "Quantity": newQuantity };

		try {
			// Kiểm tra tồn kho trước khi cập nhật
			const stockResponse = await $.ajax({
				type: 'POST',
				url: '/Product/SanPham?handler=GetStock',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify({ "ProductKey": productKey }),
			});

			const stock = stockResponse[0];

			// Kiểm tra nếu số lượng yêu cầu vượt tồn kho
			if (newQuantity > stock) {
				alert(`Số lượng yêu cầu (${newQuantity}) vượt quá tồn kho hiện có (${stock}).`);
				return; // Không tiếp tục nếu vượt quá tồn kho
			}

			// Tiến hành cập nhật nếu hợp lệ
			await $.ajax({
				type: 'POST',
				url: '/GioHang/ChiTietGioHang?handler=UpdateCartQuantity',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify(zDataRequest),
			});

			// Cập nhật lại giao diện giỏ hàng
			GetCartDetails(CartKey);
		} catch (error) {
			console.error('Lỗi khi cập nhật giỏ hàng:', error);
			alert('Đã xảy ra lỗi khi cập nhật giỏ hàng. Vui lòng thử lại.');
		}
	}
	async function DeleteItem(element) {
		const productKey = $(element).data('id');
		const zDataRequest = { "CartKey": CartKey, "ProductKey": productKey };

		try {
			await $.ajax({
				type: 'POST',
				url: '/GioHang/ChiTietGioHang?handler=DeleteItem',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify(zDataRequest),
			});
			GetCartDetails(CartKey);
		} catch (error) {
			console.error(error);
		}
	}
</script>