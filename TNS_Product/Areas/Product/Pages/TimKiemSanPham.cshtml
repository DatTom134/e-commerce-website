																	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-dash" viewBox="0 0 16 16">
																		<path d="M4 8a.5.5 0 0 1 .5-.5h7a.5.5 0 0 1 0 1h-7A.5.5 0 0 1 4 8"/>
																	</svg>
																</button>
																<input type="text" class="ajaxcart__qty-num number-sidebar" maxlength="3" value="${Item[4]}" min="0" data-id="${Item[3]}" data-line="${i}" aria-label="quantity" pattern="[0-9]*">
																	<button type="button" class="ajaxcart__qty-adjust ajaxcart__qty--plus items-count" data-id="${Item[3]}" data-line="${i}" data-qty="1" aria-label="+">
																	<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus" viewBox="0 0 16 16">
																		<path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4"/>
																	</svg>
																</button>
															</div>
														</div>
														<div class="grid__item one-half text-right cart_prices">
																<span class="cart-price">${VND.format(Item[7])}</span>
														</div>
													</div>
												</div>
											</div>
										</div>
									`;
			}
			content += "</div>";
			content += `
								<div class="ajaxcart__footer ajaxcart__footer--fixed cart-footer">
									<div class="ajaxcart__subtotal">
										<div class="cart__subtotal">
											<div class="cart__col-6">Tổng tiền:</div>
											<div class="text-right cart__totle"><span class="total-price">${VND.format(total)}</span></div>
										</div>
									</div>
									<div class="cart__btn-proceed-checkout-dt">
										<button onclick="window.location.href='/ThanhToan/CheckOut'" type="button" class="button btn btn-default cart__btn-proceed-checkout" id="btn-proceed-checkout" title="Thanh toán">Thanh toán</button>
									</div>
								</div>
							`;
			content += "</form>"
			$(".CartHeaderContainer").append(content);
			InitQuantityButtons();
		}
	}
	function RemoveItemCartHeader() {
		$(document).off('click', '.cart__btn-remove');
		$(document).on('click', '.cart__btn-remove', function () {
			let ProductKey = $(this).data('id');
			if (!CartKey) {
				console.error('CartKey is missing');
				return;
			}
			var zDataRequest = {
				'CartKey': CartKey,
				'ProductKey': ProductKey
			}
			$.ajax({
				type: 'POST',
				url: '/GioHang/ChiTietGioHang?handler=DeleteItem',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify(zDataRequest),
			})
				.done(function () {
					GetCartDetails(CartKey)
				})
				.fail(function (error) {
					console.log(error);
				});
		})
	}
</script>
<script>
	function ShowPopupNotification(totalQuantity, productImage, productName, productPrice) {
		$('.count_item_pr').text(totalQuantity);
		$('.backdrop__body-backdrop___1rvky').addClass('active');
		$('#popup-cart-mobile').addClass('active');
		let img = `<img src="${productImage}" alt="${productName}" />`
		$('.bodycart-mobile .thumb-1x1').html(img)
		let body_content = `
								<h4 class="product-title">${productName}</h4>
									<div class="product-new-price" bis_skin_checked="1">
										<b>${VND.format(productPrice)}</b>
										<span></span>
									</div>
						`
		$('.bodycart-mobile .body_content').html(body_content)
		$('.iconclose').on('click', function () {
			closePopup();
		});
		$('.tocontinued').on('click', function () {
			closePopup();
		});
	}
	function closePopup() {
		$('#popup-cart-mobile').removeClass('active');
		$('.backdrop__body-backdrop___1rvky').removeClass('active');
	}
</script>
<script>
	// Khởi tạo nút thay đổi số lượng
	function InitQuantityButtons() {
		$(document).off('click', '.ajaxcart__qty--minus, .ajaxcart__qty--plus');
		$(document).on('click', '.ajaxcart__qty--minus, .ajaxcart__qty--plus', async function () {
			const input = $(this).siblings('.ajaxcart__qty-num');
			let currentQty = parseInt(input.val()) || 0;
			let newQuantity = $(this).hasClass('ajaxcart__qty--minus') ? Math.max(currentQty - 1, 0) : currentQty + 1;

			if (newQuantity === 0) {
				await DeleteItem(this);
			} else {
				await UpdateCart(this, newQuantity);
			}
		});

		// Lắng nghe sự kiện thay đổi giá trị trong ô input
		$(document).off('blur', '.ajaxcart__qty-num');
		$(document).on('blur', '.ajaxcart__qty-num', async function () {
			const input = $(this);
			let newQuantity = parseInt(input.val()) || 0;
			if (newQuantity < 0) newQuantity = 0;
			const productKey = input.data('id');

			if (newQuantity === 0) {
				await DeleteItem(input);
			} else {
				await UpdateCart(input, newQuantity);
			}
		});
	}

	async function UpdateCart(element, newQuantity) {
		const productKey = $(element).data('id');
		const zDataRequest = {
			"CartKey": CartKey,
			"ProductKey": productKey,
			"Quantity": newQuantity
		};

		try {
			await $.ajax({
				type: 'POST',
				url: '/GioHang/ChiTietGioHang?handler=UpdateCartQuantity',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify(zDataRequest),
			});
			GetCartDetails(CartKey);
		} catch (error) {
			console.error(error);
		}
	}

	async function DeleteItem(element) {
		const productKey = $(element).data('id');
		const zDataRequest = { "CartKey": CartKey, "ProductKey": productKey };

		try {
			await $.ajax({
				type: 'POST',
				url: '/GioHang/ChiTietGioHang?handler=DeleteItem',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify(zDataRequest),
			});
			GetCartDetails(CartKey);
		} catch (error) {
			console.error(error);
		}
	}
</script>





