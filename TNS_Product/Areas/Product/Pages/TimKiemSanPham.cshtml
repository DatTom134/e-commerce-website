<script>
	function getQueryParam(param) {
		const urlParams = new URLSearchParams(window.location.search);
		return urlParams.get(param);
	}
	const searchQuery = getQueryParam('q');
	console.log("Query:", searchQuery);	
	function renderSearchResults(response) {
		var zStyle_RecordView = "";
		var zContent = "";
		var n = 0;
		if (response != null) {
			n = response.length;
			if (response[0][0] == "ERR") {
				$("#txt_MessageLog").html(response[0][1].name);
				return;
			}
		}
		for (let i = 0; i < n; i++) {
			let data = response[i];
			zContent += `
				<div class='col-xl-20 col-lg-3 col-sm-4 col-6 col-fix'>
					<form action='' method='' class='variants product-action' data-cart-form data-id='${data[0]}' enctype='multipart/form-data' href='~/ChiTietSanPham/${data[0]}'>
						<div class='product-thumbnail'>
							<a class='image_thumb scale_hover' href='/ChiTietSanPham/${data[0]}' title='${data[1]}'>
								<img width='234' height='234' class='lazyload image1 loaded' src='${data[4]}' alt='${data[1]}'>
							</a>
							<div class='tag-km'></div>
							<input class='hidden' type='hidden' name='variantId' value='125640177' />
							<div class='action'>
								<button class='btn-cart btn-views add_to_cart' title='Thêm vào giỏ'>
									<svg class='icon'><use xmlns:xlink='http://www.w3.org/1999/xlink' xlink:href='#icon-cart'></use></svg>
								</button>
							</div>
						</div>
						<div class='product-info'>
							<h3 class='product-name'>
								<a class='line-clamp line-clamp-2' href='ChiTietSanPham/${data[0]}' title='${data[1]}'>${data[1]}</a>
							</h3>
							<div class='price-box' data-price='${data[3]}'>Giá: ${VND.format(data[3])}</div>
							<div ><b>Đã bán: ${data[18]} sản phẩm</b></div>
						</div>
					</form>
				</div>`;
		}
		var zDataCurrent = $("#LV_DataBody").html();
		$("#LV_DataBody").html(zDataCurrent + zContent);
	}
	function LoadSearch() 
	{
		const searchQuery = getQueryParam('q');
		const zDataRequest = { "ProductName": searchQuery };
		if (searchQuery) {
			$.ajax({
				url: '/Product/SanPham?handler=SearchItem',
				type: 'POST',
				data: JSON.stringify(zDataRequest),
				contentType: "application/json",
				dataType: "json",
				success: function (response) {
					console.log("Search Results:", response);
					renderSearchResults(response);
				},
				error: function (error) {
					console.error("Error fetching search results:", error);
					$('.search-results').html('<p>Không tìm thấy kết quả nào.</p>');
				}
			});
		} else {
			$('.search-results').html('<p>Vui lòng nhập từ khóa tìm kiếm.</p>');
		}
	}
</script>
<script>
	var isAuthenticated = @User.Identity?.IsAuthenticated.ToString().ToLower();
	var UserID = '';
	var CartKey = '';
	var Cart
	var CartDetails = []


	$(document).ready(function () {
		//awe_lazyloadImage();
		LoadSearch()
		if (isAuthenticated) {
			var Email = "@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value";
			var zDataRequest = {
				"Email": Email,
			};
			$.ajax({
				type: 'POST',
				url: "/Product/SanPham?handler=GetUser",
				data: JSON.stringify(zDataRequest),
				contentType: "application/json",
				dataType: "json",
			})
				.done(function (dataResponse) {
					_DataView = dataResponse;
					UserID = _DataView[0][0];
					GetCart(UserID)
				})
				.fail(function (error) {
					console.log(error)
				});
			bindAddToCartEvents()
		}
		else {
			BindAddToCartEvents();
		}
		RemoveItemCartHeader();


	});
</script>
<script>
	async function GetCart(UserID) {
		const zDataRequest = { "UserID": UserID };
		try {
			const dataResponse = await $.ajax({
				type: 'POST',
				url: "/GioHang/ChiTietGioHang?handler=GetCart",
				data: JSON.stringify(zDataRequest),
				contentType: "application/json",
				dataType: "json",
			});
			Cart = dataResponse;
			CartKey = dataResponse[0][0];
			await GetCartDetails(CartKey);
		} catch (error) {
			console.error(error);
		}
	}
</script>
<script>
	async function GetCartDetails(CartKey) {
		const zDataRequest = { "UserID": UserID };
		try {
			const dataResponse = await $.ajax({
				type: 'POST',
				url: "/GioHang/ChiTietGioHang?handler=GetCartDetails",
				data: JSON.stringify(zDataRequest),
				contentType: "application/json",
				dataType: "json",
			});
			CartDetails = dataResponse;
			show_Quantity_cart(CartDetails);
			UpdateCartHeader(CartDetails);
		} catch (error) {
			console.error(error);
		}
	}
</script>
<script>
	function show_Quantity_cart(cart) {
		let TotalQuantity = 0;
		if (!cart || cart.length === 0) {
			$('.count_item_pr').text(0);
		}
		else {
			for (let i = 0; i < cart.length; i++) {
				const Item = cart[i];
				TotalQuantity += parseInt(Item[4])
			}
			$('.count_item_pr').text(TotalQuantity);
		}
	}
</script>
