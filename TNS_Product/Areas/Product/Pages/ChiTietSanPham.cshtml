	// function tăng số lượng của của product
	async function UpdateCartItemQuantity(item, newQuantity) {
		try {
			const zDataRequest = {
				"CartKey": CartKey,
				"ProductKey": item[3],
				"Quantity": newQuantity
			};
			return await $.ajax({
				type: 'POST',
				url: '/ChiTietSanPham?handler=UpdateCartQuantity',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify(zDataRequest),
			});
		}
		catch (error){ 
			console.error('Error updating cart item quantity:', error);
			throw error;
		}
	}

	async function Add_To_Cart(productKey, quantity, price) {
		const newProduct = {
			"CartKey": CartKey,
			"ProductKey": productKey,
			"Quantity": quantity,
			"Price": price
		};
		return $.ajax({
			type: 'POST',
			url: '/GioHang/ChiTietGioHang?handler=AddToCart',
			contentType: 'application/json',
			dataType: 'json',
			data: JSON.stringify(newProduct),
		});
	}
</script>


