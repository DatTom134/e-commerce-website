<script>
	$('.addThis_iconContact .item-contact,.addThis_listSharing .addThis_close').on('click', function(e){
		if($('.addThis_listSharing').hasClass('active')){
			$('.addThis_listSharing').removeClass('active');
			$('.addThis_listSharing').fadeOut(150);				
		}
		else{		
			$('.addThis_listSharing').fadeIn(100);
			$('.addThis_listSharing').addClass('active');
		}
	});
	$('.listSharing_overlay').on('click', function(e){
		$('.addThis_listSharing').removeClass('active');
		$('.addThis_listSharing').fadeOut(150);				
	})
</script>	

<script>
	var productId = "@Model.ProductId";
	var _product;

	$(document).ready( function () {
		getProduct();
		getRelatedProducts();
	});

	function getProduct() {
		$.ajax({
			url: '/ChiTietSanPham?handler=ProductData&id=' + productId, // Gọi đến handler OnGetProductData
			type: 'POST',
			contentType: "application/json",
			data: JSON.stringify(productId),
			success: function (response) {
				if (response.success === true) 
				{
					//console.log("product_key:", productId);
					//console.log("response:", response.data);
					_product = response.data;
					// console.log(response);
					loadProductData(response.data[0]);
				} 
				else 
				{
					alert(response.data);
					//console.log("product:", response.data);
				}
			},
			error: function () {
				alert("Có lỗi xảy ra khi tải dữ liệu sản phẩm.");
			}
		});
	}

	function loadProductData(product) {

		document.querySelector('ul.breadcrumb > li > strong > span').innerHTML = product[1];


		// block_background_1 container
		var block_background_1 = document.getElementById('block-background-1');


		var title_bb_1 = block_background_1.querySelector('.title-product');
		var price_bb_1 = block_background_1.querySelector('.price.product-price');
		var stock_bb_1 = block_background_1.querySelector('.a-stock');
		var product_id_bb_1 = block_background_1.querySelector('.a-sku');
		var img_top_bb_1 = block_background_1.querySelector('.gallery-top').querySelector('#lightgallery');
		var img_bottom_bb_1 = block_background_1.querySelector('.gallery-thumbs').querySelector('#container-gallery-bottom');
		var category_bb_1 = block_background_1.querySelector('#container-category').querySelector('.a-vendor');
		var brand_bb_1 = block_background_1.querySelector('#container-brand').querySelector('.a-vendor');
		

		title_bb_1.innerHTML = product[1];
		price_bb_1.innerHTML = VND.format(product[3]);
		stock_bb_1.innerHTML = product[5] > 0 ? "Còn hàng" : "Hết hàng";
		product_id_bb_1.innerHTML = product[9];
		
		img_top_bb_1.innerHTML = `
			<a class="swiper-slide" data-hash="0" href="${product[4]}" title="Click để xem">
					<img height="400" width="400" src="${product[4]}" alt="${product[1]}" data-image="${product[4]}" class="img-responsive mx-auto d-block swiper-lazy" />
			</a>
		`;
		img_bottom_bb_1.innerHTML = `
