<script>
	var isAuthenticated = @User.Identity.IsAuthenticated.ToString().ToLower();
	var UserID = '';
	var CartKey = '';
	var Cart
	var CartDetails = []	
	$(document).ready(function () {
		awe_lazyloadImage();
		LV_LoadData_Ajax();
		if (isAuthenticated) {
			var Email = "@User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value";
			var zDataRequest = {
				"Email": Email,
			};
			$.ajax({
				type: 'POST',
				url: "/Product/SanPham?handler=GetUser",
				data: JSON.stringify(zDataRequest),
				contentType: "application/json",
				dataType: "json",
			})
				.done(function (dataResponse) {
					_DataView = dataResponse;
					UserID = _DataView[0][0];
					GetCart(UserID)
				})
				.fail(function (error) {
					console.log(error)
				});
			bindAddToCartEvents()
		}
		else {
			BindAddRequireLogin();
		}
		RemoveItemCartHeader();
	});
</script>
<script>
	async function GetCart(UserID) {
		const zDataRequest = { "UserID": UserID };
		try {
			const dataResponse = await $.ajax({
				type: 'POST',
				url: "/GioHang/ChiTietGioHang?handler=GetCart",
				data: JSON.stringify(zDataRequest),
				contentType: "application/json",
				dataType: "json",
			});
			Cart = dataResponse;
			CartKey = dataResponse[0][0];
			await GetCartDetails(CartKey);
		} catch (error) {
			console.error(error);
		}
	}
</script>
<script>
	async function GetCartDetails(CartKey) {
		const zDataRequest = { "UserID": UserID };
		try {
			const dataResponse = await $.ajax({
				type: 'POST',
				url: "/GioHang/ChiTietGioHang?handler=GetCartDetails",
				data: JSON.stringify(zDataRequest),
				contentType: "application/json",
				dataType: "json",
			});
			CartDetails = dataResponse;
			show_Quantity_cart(CartDetails);
			UpdateCartHeader(CartDetails);			
		} catch (error) {
			console.error(error);
		}
	}
</script>
<script>
	function LV_LoadData_Ajax() {
		var zDataRequest = {
			"Search": '2', "statusKey": '1'
		};
		$.ajax({
			type: 'POST',
			url: "/Product/SanPham?handler=LoadData1",
			data: JSON.stringify(zDataRequest),
			contentType: "application/json",
			dataType: "json",
		})
			.done(function (dataResponse) {
				_DataView = dataResponse;
				LV_DisplayData();
				$("#LV_Waiting").css("display", "none");
			})
			.fail(function (error) {
				alert('Error : ' + error.responseText);
			});
	}
	function LV_DisplayData() {
		var zStyle_RecordView = "";
		var zContent = "";
		var n = 0;
		if (_DataView != null) {
			n = _DataView.length;
			if (_DataView[0][0] == "ERR") {
				$("#txt_MessageLog").html(_DataView[0][1].name);
