	<style>
		.product-rating {
			color: gray;
			font-size: 15px;
		}

		.product-sales {
			font-size: 15px;
		}

		.swiper-wrapper {
			position: relative;
			width: 100%;
			height: fit-content !important;
			z-index: 1;
			display: flex;
			transition-property: transform;
			box-sizing: content-box;
		}

