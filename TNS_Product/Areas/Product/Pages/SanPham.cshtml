			}
		}
		for (let i = 0; i < n; i++) {
			let data = _DataView[i];
			zContent += `
					<div class='col-xl-20 col-lg-3 col-sm-4 col-6 col-fix'>
						<form action='' method='' class='variants product-action' data-cart-form data-id='${data[0]}' enctype='multipart/form-data' href='~/ChiTietSanPham/${data[0]}'>
							<div class='product-thumbnail'>
								<a class='image_thumb scale_hover' href='/ChiTietSanPham/${data[0]}' title='${data[1]}'>
									<img width='234' height='234' class='lazyload image1 loaded' src='${data[4]}' data-src='~/images/Logo.png' alt='${data[1]}'>
								</a>
								<div class='tag-km'></div>
								<input class='hidden' type='hidden' name='variantId' value='125640177' />
								<div class='action'>
									<button class='btn-cart btn-views add_to_cart' title='Thêm vào giỏ'>
										<svg class='icon'><use xmlns:xlink='http://www.w3.org/1999/xlink' xlink:href='#icon-cart'></use></svg>
									</button>
								</div>
							</div>
							<div class='product-info'>
								<h3 class='product-name'>
									<a class='line-clamp line-clamp-2' href='~/ChiTietSanPham/${data[0]}' title='${data[1]}'>${data[1]}</a>
								</h3>
								<div class='price-box' data-price='${data[3]}'>${VND.format(data[3])}</div>
							</div>
						</form>
					</div>`;
		}
		var zDataCurrent = $("#LV_DataBody").html();
		$("#LV_DataBody").html(zDataCurrent + zContent);
	}
</script>
<script>
	function show_Quantity_cart(cart) {
		let TotalQuantity = 0;
		if (!cart || cart.length === 0) {
			$('.count_item_pr').text(0);
		}
		else {
			for (let i = 0; i < cart.length; i++) {
				const Item = cart[i];
				TotalQuantity += parseInt(Item[4])
			}
			$('.count_item_pr').text(TotalQuantity);
		}
	}
</script>
<script>
	function awe_lazyloadImage() {
		var ll = new LazyLoad({
			elements_selector: ".lazyload",
			load_delay: 100,
			threshold: 0
		});
	}
	window.awe_lazyloadImage = awe_lazyloadImage;
</script>
<script>
	function bindAddToCartEvents() {
		$('#LV_DataBody').on('click', '.add_to_cart', async function (e) {
			e.preventDefault();

			const productElement = $(this).closest('.product-action');
			const productKey = productElement.attr('data-id');
			const productName = productElement.find('.product-name a').text();
			const productPrice = productElement.find('.price-box').attr('data-price');
			const productImage = productElement.find('.product-thumbnail img').attr('src');

			try {
				let existingProduct = CartDetails.find(item => item[3] === productKey);
				if (existingProduct) {
					await UpdateCartItemQuantity(existingProduct, parseInt(existingProduct[4]) + 1);
				} else {
					await AddToCart(productKey, 1, parseFloat(productPrice));
				}

				GetCartDetails(CartKey);
				ShowPopupNotification(CartDetails.reduce((total, item) => total + parseInt(item[4]), 0), productImage, productName, productPrice);
			} catch (error) {
				console.error(error);
			}
		});
	}

	async function UpdateCartItemQuantity(item, newQuantity) {
		const zDataRequest = {
			"CartKey": CartKey,
			"ProductKey": item[3],
			"Quantity": newQuantity
		};
		// Kiểm tra số lượng thêm có vượt quá sản phẩm trong kho không
		try {
			const stockResponse = await $.ajax({
				type: 'POST',
				url: '/Product/SanPham?handler=GetStock',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify({ "ProductKey": item[3] }),
			});
			console.log(stockResponse)
			const stock = stockResponse[0];
			// Kiểm tra số lượng
			if (newQuantity > stock) {
				// Số lượng yêu cầu vượt tồn kho, hiển thị thông báo lỗi
				alert(`Số lượng yêu cầu (${newQuantity}) vượt quá tồn kho hiện có (${stock}).`);
				return Promise.reject(`Requested quantity exceeds stock.`);
			}
			const updateResponse = await $.ajax({
				type: 'POST',
				url: '/GioHang/ChiTietGioHang?handler=UpdateCartQuantity',
				contentType: 'application/json',
				dataType: 'json',
				data: JSON.stringify(zDataRequest),
			});
			return updateResponse;
		}
		catch (error) {
			console.error('Lỗi khi cập nhật số lượng:', error);
			alert('Đã xảy ra lỗi khi cập nhật số lượng. Vui lòng thử lại.');
			return Promise.reject(error);
		}
	}

	async function AddToCart(productKey, quantity, price) {
		const newProduct = {
			"CartKey": CartKey,
			"ProductKey": productKey,
			"Quantity": quantity,
			"Price": price
		};
		return $.ajax({
			type: 'POST',
			url: '/GioHang/ChiTietGioHang?handler=AddToCart',
			contentType: 'application/json',
			dataType: 'json',
			data: JSON.stringify(newProduct),
		});
	}
	function BindAddRequireLogin() {
		$('#LV_DataBody').on('click', '.add_to_cart', function (e) {
			e.preventDefault();
			ShowLoginRequiredPopup();
		});
	}
	function ShowLoginRequiredPopup() {
		$loginRequiredModal = new bootstrap.Modal(document.getElementById('loginRequiredModal'), {
			backdrop: true,
			keyboard: true
		});
		$('#loginRequiredModal .btn-close').on('click', function () {
			$loginRequiredModal.hide();
		});
		$('#loginRedirectBtn').on('click', function () {
			window.location.href = 'Account/Login';
		});
		$loginRequiredModal.show();
	}
</script>
<script>	
	function UpdateCartHeader(cart) {
